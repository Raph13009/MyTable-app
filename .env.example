# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Obtenez ces valeurs depuis votre dashboard Supabase :
# https://app.supabase.com/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# ⚠️ IMPORTANT: Service Role Key (gardez-la secrète !)
# Trouvez-la dans Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# URL de base de votre application
# En local : http://localhost:3000
# En production : https://your-app.vercel.app

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-public-token-here

# ============================================
# EMAIL CONFIGURATION (RESEND)
# ============================================
# Option 1 : Utiliser Resend (recommandé)
# 1. Créez un compte sur https://resend.com
# 2. Obtenez votre API key dans le dashboard
# 3. Configurez votre domaine d'envoi
# 4. Utilisez un email vérifié comme FROM_EMAIL

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com
EMAIL_PROVIDER=resend

# ============================================
# EMAIL CONFIGURATION (MAKE - Alternative)
# ============================================
# Option 2 : Utiliser Make (webhook)
# Si vous préférez utiliser Make au lieu de Resend,
# décommentez ces lignes et commentez les lignes Resend ci-dessus

# EMAIL_PROVIDER=make
# MAKE_WEBHOOK_URL=https://hook.us1.make.com/your-webhook-url

WHATSAPP_PHONE_NUMBER_ID=1175854655612281
WHATSAPP_BUSINESS_ACCOUNT_ID=1836206117339385
WHATSAPP_ACCESS_TOKEN=EAA...
# Booking WhatsApp notifications (keep false until production validation is complete)
WHATSAPP_BOOKING_NOTIFICATIONS_ENABLED=false
# Optional: override Meta template names (defaults shown)
# WHATSAPP_TEMPLATE_NEW_BOOKING_CHEF=mytable_demande_reservation_chef
# WHATSAPP_TEMPLATE_FALLBACK_BOOKING_CHEF=mytable_chef_fallback_booking
